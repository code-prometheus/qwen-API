# Qwen Web2API Server 环境变量配置
# 复制此文件为 .env 并填入你的信息

# 千问登录邮箱（必填）
QWEN_EMAIL=your_email@qq.com

# 千问登录密码（必填）
QWEN_PASSWORD=your_password

# API 鉴权密钥（逗号分隔多个）
API_KEYS=sk-deepseek-default-key

# 监听端口
PORT=5419

# 绑定地址
HOST=0.0.0.0

# 模式: expert / quick（quick 禁用 thinking）
MODE=expert

# 默认启用思考模式
THINKING=true

# 默认启用搜索
SEARCH=false

# 最大并发请求数
MAX_CONCURRENT=5

# 超并发处理: true=直接拒绝, false=排队
FAIL_FAST=true
